{
  "name": "geojson-distance-elevation-app",
  "version": "1.0.0",
  "description": "Desktop GeoJSON analyzer for distance and elevation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.example.geojsonanalyzer",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": ["nsis", "zip"]
    }
  }
}
